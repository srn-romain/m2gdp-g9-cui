{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "La Bonne Tablée, jetons de typographie et de couleur. Source de vérité du dossier design-system/.",
  "couleur": {
    "$type": "color",
    "terracotta": {
      "$value": "#DB5A3B",
      "$description": "Charte. Actions principales, accents décoratifs."
    },
    "creme": {
      "$value": "#FAF7F2",
      "$description": "Charte. Fond de tous les écrans, texte posé sur un fond coloré."
    },
    "sauge": {
      "$value": "#5B8266",
      "$description": "Charte. Titres Chewy de 24 px et plus, icônes."
    },
    "ardoise": {
      "$value": "#2B2B2B",
      "$description": "Charte. Texte de lecture."
    },
    "sauge-fonce": {
      "$value": "#3F5A48",
      "$description": "Extension à valider. Même teinte que le vert sauge, pour les titres de 18 à 20 px et les petites étiquettes vertes. Contraste 7,1:1 sur crème."
    },
    "texte-secondaire": {
      "$value": "rgba(43, 43, 43, 0.7)",
      "$description": "Ardoise à 70 %. Pour tout texte secondaire : méta, horodatages, aide de champ. Contraste 5,2:1 sur crème."
    },
    "texte-sur-accent": {
      "$value": "#FAF7F2",
      "$description": "Crème. Texte des boutons pleins, terracotta ou sauge."
    },
    "surface": {
      "$value": "#FFFFFF",
      "$description": "Fond des champs de saisie. La charte réserve #FAF7F2 aux fonds d'écran : dans la maquette, les champs sont blancs."
    }
  },
  "police": {
    "titres": {
      "$type": "fontFamily",
      "$value": ["Chewy", "Comic Sans MS", "cursive"],
      "$description": "Titres uniquement. Une seule graisse : 400."
    },
    "texte": {
      "$type": "fontFamily",
      "$value": ["DM Sans", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
      "$description": "Interface et corps de texte. Graisses 400, 500 et 700 uniquement."
    }
  },
  "typographie": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chewy",
        "fontWeight": 400,
        "fontSize": "32px",
        "lineHeight": "38px",
        "letterSpacing": "-0.5px"
      },
      "$description": "Titre plein écran : Bienvenue !, Bon retour !",
      "$extensions": { "lbt": { "role": "titre", "couleur": "couleur.ardoise" } }
    },
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chewy",
        "fontWeight": 400,
        "fontSize": "28px",
        "lineHeight": "34px",
        "letterSpacing": "-0.4px"
      },
      "$description": "Titre d'écran : Bonjour bernard !, Messages, Ma tablée, Mes recettes, Votre contribution.",
      "$extensions": { "lbt": { "role": "titre", "couleur": "couleur.sauge" } }
    },
    "title-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chewy",
        "fontWeight": 400,
        "fontSize": "24px",
        "lineHeight": "30px",
        "letterSpacing": "-0.3px"
      },
      "$description": "Titre de section et titre de fiche : À venir, Passées, Les contributions, Gratin dauphinois chez Léonie.",
      "$extensions": { "lbt": { "role": "titre", "couleur": "couleur.sauge" } }
    },
    "title-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chewy",
        "fontWeight": 400,
        "fontSize": "20px",
        "lineHeight": "26px",
        "letterSpacing": "-0.2px"
      },
      "$description": "Nom de tablée sur les cartes, encarts, bulles de la mascotte.",
      "$extensions": { "lbt": { "role": "titre", "couleur": "couleur.sauge-fonce" } }
    },
    "title-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chewy",
        "fontWeight": 400,
        "fontSize": "18px",
        "lineHeight": "24px",
        "letterSpacing": "-0.2px"
      },
      "$description": "Nom de tablée en liste compacte, blocs secondaires. Taille minimale pour Chewy.",
      "$extensions": { "lbt": { "role": "titre", "couleur": "couleur.sauge-fonce" } }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 400,
        "fontSize": "17px",
        "lineHeight": "25px",
        "letterSpacing": "-0.2px"
      },
      "$description": "Descriptions et résumés de tablée.",
      "$extensions": { "lbt": { "role": "corps", "couleur": "couleur.ardoise" } }
    },
    "body-lg-strong": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 700,
        "fontSize": "17px",
        "lineHeight": "25px",
        "letterSpacing": "-0.2px"
      },
      "$description": "Libellés de bloc : Ce que chacun apporte, Contributions.",
      "$extensions": { "lbt": { "role": "corps", "couleur": "couleur.ardoise" } }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 400,
        "fontSize": "15px",
        "lineHeight": "22px",
        "letterSpacing": "0px"
      },
      "$description": "Lignes de liste, champs de saisie, valeurs de méta : Aujourd'hui / 12 h 30, Lyon 7e / 700 m.",
      "$extensions": { "lbt": { "role": "corps", "couleur": "couleur.ardoise" } }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": "20px",
        "letterSpacing": "0px"
      },
      "$description": "Mentions, aide sous les champs, horodatages.",
      "$extensions": { "lbt": { "role": "corps", "couleur": "couleur.texte-secondaire" } }
    },
    "label-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 500,
        "fontSize": "15px",
        "lineHeight": "20px",
        "letterSpacing": "0px"
      },
      "$description": "Chips de filtre, Végétarien ou Ce soir, et onglets de liste Toutes / Mes tablées.",
      "$extensions": { "lbt": { "role": "etiquette", "couleur": "couleur.ardoise" } }
    },
    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 500,
        "fontSize": "13px",
        "lineHeight": "18px",
        "letterSpacing": "0.1px"
      },
      "$description": "Badges et compteurs : Végétarien, Allergènes indiqués, Voir tout (2), 3 places disponibles.",
      "$extensions": { "lbt": { "role": "etiquette", "couleur": "couleur.texte-secondaire" } }
    },
    "button-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 700,
        "fontSize": "18px",
        "lineHeight": "24px",
        "letterSpacing": "0px"
      },
      "$description": "CTA pleine largeur. 18 px gras est le minimum pour que le crème sur terracotta passe le contraste AA.",
      "$extensions": { "lbt": { "role": "action", "couleur": "couleur.texte-sur-accent" } }
    },
    "button-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 500,
        "fontSize": "16px",
        "lineHeight": "22px",
        "letterSpacing": "0px"
      },
      "$description": "Boutons et liens secondaires : Ajouter un ingrédient, Modifier la tablée, Écrire à Léonie.",
      "$extensions": { "lbt": { "role": "action", "couleur": "couleur.terracotta" } }
    },
    "nav-label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 500,
        "fontSize": "12px",
        "lineHeight": "16px",
        "letterSpacing": "0.1px"
      },
      "$description": "Barre d'onglets : Accueil, Explorer, Créer, Messages, Profil.",
      "$extensions": { "lbt": { "role": "navigation", "couleur": "couleur.ardoise" } }
    },
    "micro": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Sans",
        "fontWeight": 400,
        "fontSize": "12px",
        "lineHeight": "16px",
        "letterSpacing": "0.1px"
      },
      "$description": "Très petites mentions : durées, distances, numéros d'étape.",
      "$extensions": { "lbt": { "role": "micro", "couleur": "couleur.texte-secondaire" } }
    }
  }
}
