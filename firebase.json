{
  "hosting": [
    { "target": "landing", "public": "landing" },
    {
      "target": "app",
      "public": "public/dist",
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "comment": "HTML et service worker : toujours revalider, sinon un onglet garde l'ancien index et demande des chunks supprimés.",
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "comment": "Les fichiers d'assets portent une empreinte : ils peuvent être mis en cache très longtemps.",
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    }
  ],
  "firestore": { "rules": "firestore.rules" },
  "database": { "rules": "database.rules.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081 },
    "database": { "port": 9000 },
    "hosting": { "port": 5001 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true }
  }
}
