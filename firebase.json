{
  "hosting": [
    { "target": "landing", "public": "landing" },
    {
      "target": "app",
      "public": "public/dist",
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ],
  "firestore": { "rules": "firestore.rules" },
  "database": { "rules": "database.rules.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081 },
    "database": { "port": 9000 },
    "hosting": { "port": 5001 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true }
  }
}
