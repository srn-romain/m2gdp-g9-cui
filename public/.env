# La Bonne Tablée — configuration publique du front (Supabase).
# La clé « publishable » de Supabase est publique par conception : la sécurité repose sur
# les Row Level Security policies. La clé service_role, elle, reste côté serveur.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=false
